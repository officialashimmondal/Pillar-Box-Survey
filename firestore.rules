rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: surveys
    // Fields:
    //   - surveyorName: string (required)
    //   - surveyDate: string (required, date format)
    //   - pillarBoxName: string (required)
    //   - category: string (required, enum)
    //   - pillarType: string (required, enum)
    //   - pillarSize: string (required, enum)
    //   - doorCondition: string
    //   - basePlateCondition: string
    //   - blankOff: string
    //   - lock: string
    //   - doorStatus: string
    //   - hingeBroken: boolean
    //   - pbInclined: boolean
    //   - raisingRequired: boolean
    //   - garbageBlockage: boolean
    //   - pbAddress: string (required)
    //   - findings: string
    //   - createdBy: string (required, UID)
    //   - createdAt: timestamp (required)

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "official.ashimmondal@gmail.com" && request.auth.token.email_verified == true);
    }

    function isOwner(data) {
      return isAuthenticated() && request.auth.uid == data.createdBy;
    }

    function isValidSurvey(data) {
      return data.keys().hasAll(['surveyorName', 'surveyDate', 'pillarBoxName', 'category', 'pillarType', 'pillarSize', 'pbAddress', 'createdAt', 'createdBy']) &&
             data.surveyorName is string && data.surveyorName.size() > 0 && data.surveyorName.size() < 100 &&
             data.surveyDate is string &&
             data.pillarBoxName is string && data.pillarBoxName.size() > 0 && data.pillarBoxName.size() < 100 &&
             data.category in ['ACPB', 'FEEDER PILLAR', 'LINK PILLAR'] &&
             data.pillarType in ['MODIFIED', 'CONVENTIONAL'] &&
             data.pillarSize in ['2WAY', '4WAY', '6WAY', '8WAY'] &&
             data.pbAddress is string && data.pbAddress.size() > 0 && data.pbAddress.size() < 1000 &&
             data.createdAt is timestamp &&
             data.createdBy == request.auth.uid;
    }

    match /surveys/{surveyId} {
      // Allow users to read only their own surveys
      allow read: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      
      // Allow users to create surveys tagged with their UID
      allow create: if isValidSurvey(request.resource.data);
      
      // Allow users to update/delete only their own surveys
      allow update: if isOwner(resource.data) && isValidSurvey(request.resource.data);
      allow delete: if isOwner(resource.data);
    }
  }
}
