rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: surveys
    // Fields:
    //   - surveyorName: string (required)
    //   - surveyDate: string (required, date format)
    //   - pillarBoxName: string (required)
    //   - category: string (required, enum)
    //   - pillarType: string (required, enum)
    //   - pillarSize: string (required, enum)
    //   - doorCondition: string
    //   - basePlateCondition: string
    //   - blankOff: string
    //   - lock: string
    //   - doorStatus: string
    //   - hingeBroken: boolean
    //   - pbInclined: boolean
    //   - raisingRequired: boolean
    //   - garbageBlockage: boolean
    //   - pbAddress: string (required)
    //   - findings: string
    //   - createdBy: string (required, UID)
    //   - createdAt: timestamp (required)

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "official.ashimmondal@gmail.com" && request.auth.token.email_verified == true);
    }

    function isOwner(data) {
      return isAuthenticated() && request.auth.uid == data.createdBy;
    }

    function isValidSurvey(data, isUpdate) {
      return data.keys().hasAll(['surveyorName', 'surveyDate', 'pillarBoxName', 'category', 'pillarType', 'pillarSize', 'pbAddress', 'createdBy']) &&
             data.surveyorName is string &&
             data.surveyDate is string &&
             data.pillarBoxName is string &&
             data.category is string &&
             data.pillarType is string &&
             data.pillarSize is string &&
             data.pbAddress is string &&
             data.createdBy == request.auth.uid &&
             (isUpdate || data.createdAt == request.time);
    }

    match /surveys/{surveyId} {
      // Allow users to read only their own surveys
      allow read: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      
      // Allow users to create surveys tagged with their UID
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      
      // Allow users to update/delete only their own surveys
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
  }
}
